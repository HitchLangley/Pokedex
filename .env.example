# Copy to .env (optional). Everything works locally without it:
# an embedded database (PGlite) is created in .data/ and a dev-only sign-in is enabled.

# Postgres connection string. Leave empty to use the embedded PGlite database.
DATABASE_URL=

# GitHub OAuth app (https://github.com/settings/developers → New OAuth App)
# Authorization callback URL locally: http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Required in production: random string, 32+ characters
SESSION_SECRET=

# Public address of the app; used for the OAuth callback. Locally defaults to the Vite dev server.
PUBLIC_URL=
